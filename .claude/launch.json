{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "laravel",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "artisan",
        "serve",
        "--port=8000"
      ],
      "port": 8000
    },
    {
      "name": "laravel-8001",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "artisan",
        "serve",
        "--port=8001"
      ],
      "port": 8001
    },
    {
      "name": "docs-design",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "-S",
        "127.0.0.1:8090",
        "-t",
        "docs/design"
      ],
      "port": 8090
    }
  ]
}
